# mema-twin.service — systemd unit 模板（远端/自托管 sidecar 形态）。
#
# 使用：复制到 /etc/systemd/system/mema-twin.service，替换下面 3 个 <...>
# 占位符，然后 `systemctl daemon-reload && systemctl enable --now mema-twin`：
#   <venv>          venv 安装路径（ExecStart 用其 bin/mema-twin）
#   <user>          运行账号（专用非特权账号，勿 root）
#   <twin-base>     twin 数据根目录（twin.sqlite3 / prompts/ 等落这里）
#
# 形态：偏好本体自持 twin.sqlite3（v0.5.0 拆分，不写 mema）；宿主 Agent 经
# SSH 隧道接 127.0.0.1:8765/mcp。
#
# 安全边界（不变量）：
# - MEMA_TWIN_HTTP_HOST 必须 loopback——X-Mema-Client 不是鉴权，对外暴露
#   等于开放身份伪造（twin 启动自检强制，mema core 同款策略）。
# - UMask=0077：twin.sqlite3 与 prompts/ 镜像含个人画像，0600；twin.sqlite3
#   是偏好唯一副本（v0.5.0 自持），自托管需自配备份（见 README「备份」节）。

[Unit]
Description=mema-twin (personal work twin MCP server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

ExecStart=<venv>/bin/mema-twin
User=<user>
WorkingDirectory=<twin-base>

UMask=0077

Environment=MEMA_TWIN_TRANSPORT=http
Environment=MEMA_TWIN_HTTP_HOST=127.0.0.1
Environment=MEMA_TWIN_HTTP_PORT=8765

# 网关定位端点（v0.5.0 语义收窄）：仅多租户形态需要（whoami 解析租户），
# 单用户自持形态无需设置
#Environment=MEMA_TWIN_MEMA_URL=http://127.0.0.1:8000/mcp

# 多租户形态（服务网关的多个用户）：指向网关 users 目录——账本/镜像按租户
# 落 users/<uid>/，token 随请求透传（静态 token env 与镜像/DB env 均不可设，
# 且仅支持 http 传输）。单用户自托管不设此行。运行账号需对该目录有写权
#（网关部署中通常即网关服务账号）。此形态还需放开上方 MEMA_TWIN_MEMA_URL
#（指向网关，whoami 定位用）。
#Environment=MEMA_TWIN_USERS_DIR=<gateway-users-dir>

# twin 自有数据（偏好本体/元数据/镜像）——v0.5.0 起自持库，设计如此，不是遗漏。
# ⚠️ 多租户形态（设置 MEMA_TWIN_USERS_DIR）下以下四行必须整段删除或注释
#（与之互斥，启动会 fail-fast 拒绝）；单用户自托管保留即可。
Environment=MEMA_TWIN_DB_PATH=<twin-base>/twin.sqlite3
Environment=MEMA_TWIN_PROMPTS_DIR=<twin-base>/prompts
Environment=MEMA_TWIN_PLAYBOOKS_DIR=<twin-base>/playbooks
Environment=MEMA_TWIN_DELIVERABLES_DIR=<twin-base>/deliverables

# 无外网的部署可放开下一行，关闭版本更新检查
#Environment=MEMA_TWIN_UPDATE_CHECK=0

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
